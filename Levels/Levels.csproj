<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library an engine references from its own project, which knows no engine (N 2.1).
         Its assembly and package are 3DEngine.Levels, the name it is published under beside the
         other modules, while its types stand in the namespace Levels. -->
    <PropertyGroup>
        <AssemblyName>3DEngine.Levels</AssemblyName>
        <PackageId>3DEngine.Levels</PackageId>
        <RootNamespace>Levels</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref
         that names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

    <!-- The tests read the internals a level is checked by, the number writer among them. -->
    <ItemGroup>
        <InternalsVisibleTo Include="3DEngine.Levels.Tests" />
    </ItemGroup>

</Project>
