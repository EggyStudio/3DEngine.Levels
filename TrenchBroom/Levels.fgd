// The entity classes every level of the Valve 220 map format the module reads knows, for
// TrenchBroom. An engine lists a file of its own classes beside this one in GameConfig.cfg's
// definitions, and a class neither file names stands as its place and its keys for a game to read.

@SolidClass = worldspawn : "The level's own brushes"
[
	_units_per_meter(float) : "Units a meter" : 32 : "How many units make a meter, 32 when none is given"
	_sky(string) : "Sky" : : "A sky's name, which the engine resolves"
	_ambient(color255) : "Ambient color" : "255 255 255" : "The color of the light where no light reaches, in sRGB, 0 to 255 a channel"
	_ambient_lux(float) : "Ambient lux" : 0 : "The lux it gives every surface"
]

@PointClass size(-16 -16 0, 16 16 72) color(0 255 0) = info_player_start : "Where the player starts, its arrow the way the player faces, read by the game"
[
	angle(integer) : "Yaw" : 0 : "The way the player faces, in degrees about the vertical"
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 128) = light : "A point light, its light sent every way from its place"
[
	_color(color255) : "Color" : "255 255 255" : "The color in sRGB, 0 to 255 a channel"
	intensity(float) : "Lumens" : 800 : "The lumens sent over the whole sphere, 800 a 60 watt bulb's"
	range(float) : "Range" : 10 : "How far in meters it reaches"
	style(integer) : "Style" : 0 : "The number of a preset pattern, 0 steady"
	pattern(string) : "Pattern" : : "Letters a to z its brightness follows ten a second, m its strength"
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 128) = light_spot : "A spot, its light sent in a cone the way its arrow points"
[
	angles(string) : "Pitch yaw roll" : "0 0 0" : "The way it faces in degrees, a pitch above zero looking down"
	_color(color255) : "Color" : "255 255 255" : "The color in sRGB, 0 to 255 a channel"
	intensity(float) : "Lumens" : 800 : "The lumens sent over its outer cone"
	range(float) : "Range" : 10 : "How far in meters it reaches"
	_inner_cone(float) : "Inner cone" : 25 : "Its full strength out to this angle in degrees from its axis"
	_cone(float) : "Outer cone" : 30 : "Its light out to this angle in degrees from its axis"
	style(integer) : "Style" : 0 : "The number of a preset pattern, 0 steady"
	pattern(string) : "Pattern" : : "Letters a to z its brightness follows ten a second, m its strength"
]

@PointClass size(-16 -16 -16, 16 16 16) color(255 200 64) = light_environment : "The sun, its light falling the way its arrow points across the whole level"
[
	angles(string) : "Pitch yaw roll" : "0 0 0" : "The way it shines in degrees, a pitch above zero shining down"
	_color(color255) : "Color" : "255 255 255" : "The color in sRGB, 0 to 255 a channel"
	intensity(float) : "Lux" : 100000 : "The lux it gives a surface facing it, 100000 a clear noon's"
	style(integer) : "Style" : 0 : "The number of a preset pattern, 0 steady"
	pattern(string) : "Pattern" : : "Letters a to z its brightness follows ten a second, m its strength"
]

@PointClass size(-16 -16 0, 16 16 96) color(80 160 60) = tree : "A tree grown from a species and a seed"
[
	species(string) : "Species" : : "A species' name, which the engine's vegetation resolves"
	seed(integer) : "Seed" : 0 : "The seed, which picks its variant and turns and sizes it"
]

@SolidClass = func_door : "A door, its brushes moving the way it opens by their size that way less its lip"
[
	angle(integer) : "Opens toward" : 0 : "The way it opens in degrees about the vertical, -1 up and -2 down"
	lip(float) : "Lip" : 8 : "How many units of it stay short of its full travel"
]

@SolidClass = func_button : "A button, its brushes moving the way it is pressed by their size that way less its lip"
[
	angle(integer) : "Pressed toward" : 0 : "The way it moves in degrees about the vertical, -1 up and -2 down"
	lip(float) : "Lip" : 4 : "How many units of it stay short of its full travel"
]

@SolidClass = func_rotating : "A part that turns about an axis through its origin or its brushes' middle"
[
	speed(float) : "Degrees a second" : 100 : "How fast it turns"
	spawnflags(integer) : "Flags" : 0 : "2 turns it the other way, 4 about the file's X axis, 8 about its Y, else about the vertical"
]
